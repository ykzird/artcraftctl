#!/usr/bin/env bash
# artcraftctl — installer / updater for the ArtCraft suite (storytold/*).
#
# Downloads unmodified release tarballs from GitHub releases and installs their
# bin/ into ~/.local/bin and share/ into ~/.local/share. Plain ANSI output and gh
# for GitHub access: no TUI library, no scraping.
#
# Commands:
#   artcraftctl update    --app APP | --all   Check installed vs latest release (report only)
#   artcraftctl upgrade   --app APP | --all   Update an installed app to the latest release
#   artcraftctl install   --app APP | --all   Install an app (refuses if already installed)
#   artcraftctl uninstall --app APP | --all   Remove an installed app
#   artcraftctl init                          Interactive one-time setup (writes config)
#   artcraftctl help                          Show this help
#
# APP is either a bare app name (resolved through the config) or "owner/repo".
#
# Config:   ~/.config/artcraftctl/config          one "owner/repo" per line ('#' comments ok)
# State:    ~/.local/share/artcraftctl/state/<app>          installed version
#           ~/.local/share/artcraftctl/state/<app>.files    manifest of installed files
#
# All paths honour XDG_* and can be overridden with ARTCRAFT_* env vars (testing).
#
# An install stages the payload on the destination filesystem and then renames each
# file into place, keeping the previous file in a backup directory until the whole
# set has landed. A failed or interrupted install is rolled back instead of leaving
# a half-installed app behind.

set -euo pipefail

# ------------------------------------------------------------------ paths ----
CONFIG_DIR="${ARTCRAFT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/artcraftctl}"
CONFIG_FILE="$CONFIG_DIR/config"
DATA_DIR="${ARTCRAFT_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/artcraftctl}"
STATE_DIR="$DATA_DIR/state"
BIN_DIR="${ARTCRAFT_BIN_DIR:-$HOME/.local/bin}"
SHARE_DIR="${ARTCRAFT_SHARE_DIR:-$HOME/.local/share}"
# Release asset suffix. Every release publishes one tarball per architecture, so
# this follows the machine: a hardcoded x86_64 suffix downloads and installs a
# binary that cannot run here, and still reports success. ARTCRAFT_ARCH overrides
# it for testing.
ARCH="${ARTCRAFT_ARCH:-linux-$(uname -m)}"

# --------------------------------------------------------------- ui helpers --
# Colour is emitted only when someone is looking: a tty on stdout or stderr, no
# NO_COLOR in the environment, and not a dumb terminal. Everything with a
# diagnostic meaning goes to stderr, so `artcraftctl update > report` still shows
# the status lines and help stays the only thing on stdout.
if [[ -t 1 || -t 2 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-dumb}" != dumb ]]; then
  C_HEAD=$'\033[38;5;212;1m'
  C_OK=$'\033[32m'
  C_INFO=$'\033[36m'
  C_WARN=$'\033[33m'
  C_ERR=$'\033[31m'
  C_B=$'\033[1m'
  C_0=$'\033[0m'
else
  C_HEAD=""; C_OK=""; C_INFO=""; C_WARN=""; C_ERR=""; C_B=""; C_0=""
fi

head_()  { printf '%s%s%s\n' "$C_HEAD" "$*" "$C_0" >&2; }
info_()  { printf '%sINFO%s  %s\n' "$C_INFO" "$C_0" "$*" >&2; }
ok_()    { printf '%sOK%s    %s\n' "$C_OK" "$C_0" "$*" >&2; }
warn_()  { printf '%sWARN%s  %s\n' "$C_WARN" "$C_0" "$*" >&2; }
err_()   { printf '%sERROR%s %s\n' "$C_ERR" "$C_0" "$*" >&2; }
die()    { err_ "$*"; exit 1; }
need()   { command -v "$1" >/dev/null 2>&1 || die "required tool not found: $1"; }

# A prompt needs a real terminal on both ends. Read from /dev/tty, not stdin:
# these run under $( ) where stdin is the pipe, and a report-only run (cron, ssh)
# must never block.
interactive() { [[ -t 0 || -r /dev/tty ]]; }

confirm() {  # QUESTION -> 0 = yes. No terminal, or an empty answer, means no.
  local reply=""
  interactive || return 1
  printf '%s [y/N] ' "$1" >&2
  IFS= read -r reply < /dev/tty || return 1
  [[ "$reply" == [yY]* ]]
}

ask() {  # QUESTION -> the answer on stdout; empty when there is no terminal
  local reply=""
  if ! interactive; then printf '\n'; return 0; fi
  printf '%s ' "$1" >&2
  IFS= read -r reply < /dev/tty || true
  printf '%s\n' "$reply"
}

# ------------------------------------------------------------ config/state --
read_config() {   # print every clean "owner/repo" line, one per line
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE — run 'artcraftctl init' first"
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [[ -z "$line" ]] && continue
    printf '%s\n' "$line"
  done < "$CONFIG_FILE"
}

repo_basename() { printf '%s\n' "${1##*/}"; }

resolve_repo() {  # APP (name or owner/repo) -> owner/repo
  local arg="$1" line r
  if [[ "$arg" == */* ]]; then printf '%s\n' "$arg"; return 0; fi
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="$(printf '%s' "$line" | tr -d '[:space:]')"
      [[ -z "$line" ]] && continue
      r="${line##*/}"
      if [[ "$r" == "$arg" ]]; then printf '%s\n' "$line"; return 0; fi
    done < "$CONFIG_FILE"
  fi
  die "unknown app '$arg' — not in $CONFIG_FILE and not an owner/repo"
}

is_installed() {  # APP -> 0 if installed
  local app="$1"
  [[ -f "$STATE_DIR/$app" ]] && return 0
  [[ -x "$BIN_DIR/$app" ]] && return 0
  return 1
}

installed_version() {  # APP -> version string (state first, then binary probe)
  local app="$1" v
  if [[ -f "$STATE_DIR/$app" ]]; then cat "$STATE_DIR/$app"; return 0; fi
  if command -v "$app" >/dev/null 2>&1; then
    v="$("$app" --version 2>/dev/null | awk 'NR==1{print $2}')"
    [[ -n "$v" ]] && { printf '%s\n' "$v"; return 0; }
  fi
  return 1
}

latest_tag() {  # owner/repo -> stable release tag (or empty)
  gh api "repos/$1/releases/latest" --jq '.tag_name' 2>/dev/null || true
}

ver_gt() {  # A B -> true when A is a higher version than B
  [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

# --------------------------------------------------------- target selecting --
_TARGET=()
_ASSET=""
parse_target() {  # CMDNAME [--app APP | --all]
  local cmd="$1"; shift
  local app="" all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --app)    app="${2:-}"; [[ -n "$app" ]] || die "$cmd: --app needs APP"; shift 2;;
      --app=*)  app="${1#*=}"; shift;;
      --all)    all=1; shift;;
      -h|--help) usage; exit 0;;
      *) die "$cmd: unknown option '$1'";;
    esac
  done
  [[ -n "$app" || $all -eq 1 ]] || die "$cmd needs --app APP or --all"
  if [[ $all -eq 1 ]]; then mapfile -t _TARGET < <(read_config)
  else _TARGET=("$(resolve_repo "$app")"); fi
  [[ ${#_TARGET[@]} -gt 0 ]] || die "$cmd: nothing to do"
}

_desktop_db_refresh() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$SHARE_DIR/applications" 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f "$SHARE_DIR/icons/hicolor" 2>/dev/null || true
  fi
}

_clean_desktop_caches() {  # drop caches that only existed for the files we removed
  local apps="$SHARE_DIR/applications" icons="$SHARE_DIR/icons/hicolor"
  # update-desktop-database leaves a cache behind even when no .desktop is left;
  # only drop it once nothing else in that directory needs it.
  if [[ -f "$apps/mimeinfo.cache" ]] && ! compgen -G "$apps/*.desktop" >/dev/null 2>&1; then
    rm -f "$apps/mimeinfo.cache"
  fi
  if [[ -f "$icons/icon-theme.cache" ]] && ! compgen -G "$icons/*/*" >/dev/null 2>&1; then
    rm -f "$icons/icon-theme.cache"
  fi
}

_prune_parents() {  # PATH... -> remove now-empty ancestor dirs below BIN_DIR/SHARE_DIR
  local p d list=()
  for p in "$@"; do
    [[ -z "$p" ]] && continue
    d="$(dirname "$p")"
    while [[ "$d" == "$SHARE_DIR"/* || "$d" == "$BIN_DIR"/* ]]; do
      list+=("$d"); d="$(dirname "$d")"
    done
  done
  [[ ${#list[@]} -gt 0 ]] || return 0
  # deepest first, so a dir is only tried after all of its children are gone
  printf '%s\n' "${list[@]}" \
    | awk '{n=gsub("/","/"); print n"\t"$0}' \
    | sort -rn -k1,1 \
    | cut -f2- \
    | while IFS= read -r d; do rmdir "$d" 2>/dev/null || true; done
}

# ----------------------------------------------------------------- update ----
update_one() {  # owner/repo -> report only
  local repo="$1" app latest inst
  app="$(repo_basename "$repo")"
  latest="$(latest_tag "$repo")"
  [[ -n "$latest" ]] || { warn_ "$repo: no stable release found (or repo unreachable)"; return 1; }
  latest="${latest#v}"

  if ! is_installed "$app"; then
    info_ "$app: not installed (latest: $latest) — run 'artcraftctl install --app $app'"; return 0
  fi
  inst="$(installed_version "$app" || true)"
  if [[ -z "$inst" ]]; then warn_ "$app: installed, but version could not be determined"; return 1; fi

  if [[ "$inst" == "$latest" ]]; then
    ok_ "$app: up to date ($inst)"
  elif ver_gt "$latest" "$inst"; then
    warn_ "$app: update available ($inst -> $latest) — run 'artcraftctl upgrade --app $app'"
  else
    ok_ "$app: installed $inst is newer than the latest release ($latest)"
  fi
}

cmd_update() {
  parse_target update "$@"
  local r rc=0
  head_ "artcraftctl update"
  for r in "${_TARGET[@]}"; do update_one "$r" || rc=1; done
  return $rc
}

# ---------------------------------------------------------------- install ----
pick_asset() {  # repo tag -> tarball asset name on stdout
  local repo="$1" tag="$2" app ver exact pick
  app="$(repo_basename "$repo")"; ver="${tag#v}"
  local names
  names="$(gh release view "$tag" -R "$repo" --json assets --jq '.assets[].name' 2>/dev/null || true)"
  [[ -n "$names" ]] || { err_ "$repo: could not list the assets of release $tag"; return 1; }

  # The asset name is not derivable from the repo name (craft-launcher publishes
  # artcraft-launcher-...), so read the release instead of composing a filename.
  exact="${app}-${ver}-${ARCH}.tar.gz"
  if printf '%s\n' "$names" | grep -qxF "$exact"; then printf '%s\n' "$exact"; return 0; fi
  pick="$(printf '%s\n' "$names" | grep -E -- "-${ver}-${ARCH}\.tar\.gz$" | grep -v -- '-cli-' | head -1)"
  if [[ -z "$pick" ]]; then
    err_ "$repo: no ${ver} ${ARCH} tarball in release $tag"
    err_ "available assets: $(printf '%s\n' "$names" | tr '\n' ' ')"
    return 1
  fi
  printf '%s\n' "$pick"
}

_stage_release() {  # repo tag tmp -> verified tree in $tmp/x, asset name in _ASSET
  local repo="$1" tag="$2" tmp="$3" app sum
  app="$(repo_basename "$repo")"

  _ASSET="$(pick_asset "$repo" "$tag")" || return 1
  info_ "$app: downloading $_ASSET"
  gh release download "$tag" -R "$repo" -p "$_ASSET" -D "$tmp" \
    || { err_ "$repo: download failed"; return 1; }
  gh release download "$tag" -R "$repo" -p 'SHA256SUMS.txt' -D "$tmp" >/dev/null 2>&1 || true

  # An unverified binary is not installed: the release either carries a checksum
  # for this asset or the install stops here.
  [[ -f "$tmp/SHA256SUMS.txt" ]] \
    || { err_ "$app: release $tag ships no SHA256SUMS.txt; refusing to install unverified"; return 1; }
  sum="$(awk -v f="$_ASSET" '$2 == f' "$tmp/SHA256SUMS.txt")"
  [[ -n "$sum" ]] || { err_ "$app: no checksum entry for $_ASSET in SHA256SUMS.txt"; return 1; }
  ( cd "$tmp" && printf '%s\n' "$sum" | sha256sum -c - >/dev/null ) \
    || { err_ "$app: checksum verification FAILED - not installing"; return 1; }
  ok_ "$app: checksum verified"

  mkdir -p "$tmp/x"
  tar xzf "$tmp/$_ASSET" -C "$tmp/x" --strip-components=1 \
    || { err_ "$app: extraction failed"; return 1; }
  [[ -d "$tmp/x/bin" ]] || { err_ "$app: tarball has no bin/ directory"; return 1; }
}

_install_staged() {  # repo ver tmp -> place the staged tree transactionally
  local repo="$1" ver="$2" tmp="$3" app
  app="$(repo_basename "$repo")"
  local old_manifest="$STATE_DIR/$app.files"
  mkdir -p "$BIN_DIR" "$SHARE_DIR" "$STATE_DIR"

  # Leftovers from a killed run are useless; a day is well past any real install.
  find "$DATA_DIR" -maxdepth 1 -type d \( -name '.stage.*' -o -name '.backup.*' \) -mtime +0 \
    -exec rm -rf {} + 2>/dev/null || true

  # Same filesystem as the payload, because rename() across filesystems is a copy
  # and a copy is exactly what we must not depend on.
  local stage backup
  stage="$(mktemp -d "$DATA_DIR/.stage.XXXXXX")"
  backup="$(mktemp -d "$DATA_DIR/.backup.XXXXXX")"

  # 1. build the payload next to its destination
  mkdir -p "$stage/bin"
  cp -a "$tmp/x/bin/." "$stage/bin/"
  if [[ -d "$tmp/x/share" ]]; then
    mkdir -p "$stage/share"
    cp -a "$tmp/x/share/." "$stage/share/"
  fi

  # 2. move it in, one file at a time, keeping the replaced file in the backup
  local -a rels=() placed=()
  while IFS= read -r rel; do rels+=("$rel"); done < <(
    cd "$stage" && { if [[ -d share ]]; then find bin share -type f; else find bin -type f; fi; } | sort
  )
  if [[ ${#rels[@]} -eq 0 ]]; then
    rm -rf "$stage" "$backup"
    err_ "$app: nothing to install in the tarball"; return 1
  fi

  local rel src dst bslot ok=1 i
  for rel in "${rels[@]}"; do
    case "$rel" in
      bin/*)   src="$stage/$rel"; dst="$BIN_DIR/${rel#bin/}";;
      share/*) src="$stage/$rel"; dst="$SHARE_DIR/${rel#share/}";;
      *)       continue;;
    esac
    bslot="$backup/$rel"
    mkdir -p "$(dirname "$dst")" || { ok=0; break; }
    if [[ -e "$dst" ]]; then
      mkdir -p "$(dirname "$bslot")" || { ok=0; break; }
      mv -f "$dst" "$bslot" || { ok=0; break; }
    fi
    mv -f "$src" "$dst" || { ok=0; break; }
    placed+=("$dst")
  done

  # 3. roll back if anything refused to land
  if [[ $ok -eq 0 ]]; then
    err_ "$app: could not place the files — rolling back"
    for (( i = ${#placed[@]} - 1; i >= 0; i-- )); do rm -f "${placed[i]}"; done
    while IFS= read -r rel; do
      [[ -z "$rel" ]] && continue
      case "$rel" in
        bin/*)   dst="$BIN_DIR/${rel#bin/}";;
        share/*) dst="$SHARE_DIR/${rel#share/}";;
        *)       continue;;
      esac
      mkdir -p "$(dirname "$dst")" && mv -f "$backup/$rel" "$dst" || true
    done < <( cd "$backup" && find . -type f -printf '%P\n' | sort )
    _prune_parents "${placed[@]:-}"
    rm -rf "$stage" "$backup"
    return 1
  fi

  # 4. drop files the previous version had and this one does not. Only paths inside
  # the install prefixes are touched, whatever the old manifest says.
  local -a orphans=()
  if [[ -f "$old_manifest" ]]; then
    local -A is_new=()
    for dst in "${placed[@]}"; do is_new["$dst"]=1; done
    while IFS= read -r rel || [[ -n "$rel" ]]; do
      [[ -z "$rel" ]] && continue
      case "$rel" in
        "$BIN_DIR"/*|"$SHARE_DIR"/*) ;;
        *) warn_ "$app: ignoring manifest entry outside the install prefixes: $rel"; continue;;
      esac
      [[ -n "${is_new[$rel]:-}" ]] && continue
      if [[ -e "$rel" ]]; then rm -f "$rel" && orphans+=("$rel"); fi
    done < "$old_manifest"
  fi

  # 5. record state. Both files are written aside and renamed into place, so a
  # reader never sees a half-written manifest.
  printf '%s\n' "${placed[@]}" > "$STATE_DIR/.$app.files.new"
  mv -f "$STATE_DIR/.$app.files.new" "$STATE_DIR/$app.files"
  printf '%s\n' "$ver" > "$STATE_DIR/.$app.new"
  mv -f "$STATE_DIR/.$app.new" "$STATE_DIR/$app"
  if [[ -e "$BIN_DIR/$app" ]]; then chmod +x "$BIN_DIR/$app" 2>/dev/null || true; fi

  rm -rf "$stage" "$backup"
  [[ ${#orphans[@]} -gt 0 ]] && _prune_parents "${orphans[@]}"
  _desktop_db_refresh
}

install_one() {  # owner/repo
  local repo="$1" app latest ver tmp
  app="$(repo_basename "$repo")"
  latest="$(latest_tag "$repo")"
  [[ -n "$latest" ]] || { err_ "$repo: no stable release found"; return 1; }
  ver="${latest#v}"

  if is_installed "$app"; then
    err_ "$app: already installed (version $(installed_version "$app" 2>/dev/null || echo '?')) — use 'artcraftctl upgrade'"
    return 1
  fi

  tmp="$(mktemp -d)"
  if _stage_release "$repo" "$latest" "$tmp" && _install_staged "$repo" "$ver" "$tmp"; then
    rm -rf "$tmp"; ok_ "$app: installed $ver -> $BIN_DIR/$app"; return 0
  fi
  rm -rf "$tmp"; return 1
}

cmd_install() {
  parse_target install "$@"
  local r rc=0
  head_ "artcraftctl install"
  for r in "${_TARGET[@]}"; do install_one "$r" || rc=1; done
  return $rc
}

# -------------------------------------------------------------- uninstall ----
_remove_files() {  # APP -> print the paths it removed
  local app="$1" f
  # two statements on purpose: in a single `local`, $app would still be unset here
  local manifest="$STATE_DIR/$app.files"
  if [[ -f "$manifest" ]]; then
    while IFS= read -r f || [[ -n "$f" ]]; do
      [[ -z "$f" ]] && continue
      # The manifest is a plain file in the user's own data dir, so never trust it
      # to name a path outside the two prefixes this tool installs into.
      case "$f" in
        "$BIN_DIR"/*|"$SHARE_DIR"/*) ;;
        *) warn_ "$app: ignoring manifest entry outside the install prefixes: $f"; continue;;
      esac
      if [[ -e "$f" ]]; then rm -f "$f" && printf '%s\n' "$f"; fi
    done < "$manifest"
  else
    warn_ "$app: no file manifest — falling back to best-effort removal by name"
    for f in "$BIN_DIR/$app" "$BIN_DIR/$app"-*; do
      [[ -e "$f" ]] && rm -f "$f" && printf '%s\n' "$f"
    done
  fi
}

uninstall_one() {  # owner/repo [--quiet]
  local repo="$1" quiet="${2:-}" app removed=()
  app="$(repo_basename "$repo")"
  if ! is_installed "$app"; then
    [[ "$quiet" == "--quiet" ]] || info_ "$app: not installed — nothing to remove"; return 0
  fi
  mapfile -t removed < <(_remove_files "$app")
  rm -f "$STATE_DIR/$app" "$STATE_DIR/$app.files"
  _prune_parents "${removed[@]:-}"
  _desktop_db_refresh
  # Regenerating the desktop caches can resurrect a cache for files that are gone,
  # and can leave directories empty that the first prune had already removed.
  _clean_desktop_caches
  _prune_parents "${removed[@]:-}" \
    "$SHARE_DIR/applications/mimeinfo.cache" "$SHARE_DIR/icons/hicolor/icon-theme.cache"
  [[ "$quiet" == "--quiet" ]] || ok_ "$app: uninstalled (${#removed[@]} file(s) removed)"
}

cmd_uninstall() {
  parse_target uninstall "$@"
  local r rc=0
  head_ "artcraftctl uninstall"
  for r in "${_TARGET[@]}"; do uninstall_one "$r" || rc=1; done
  return $rc
}

# ---------------------------------------------------------------- upgrade ----
upgrade_one() {  # owner/repo
  local repo="$1" app tag inst ver tmp
  app="$(repo_basename "$repo")"
  tag="$(latest_tag "$repo")"
  [[ -n "$tag" ]] || { err_ "$repo: no stable release found"; return 1; }
  ver="${tag#v}"

  if ! is_installed "$app"; then
    info_ "$app: not installed — use 'artcraftctl install --app $app'"; return 0
  fi
  inst="$(installed_version "$app" || true)"
  if [[ -n "$inst" && "$inst" == "$ver" ]]; then
    ok_ "$app: already up to date ($inst)"; return 0
  fi
  if [[ -n "$inst" ]] && ! ver_gt "$ver" "$inst"; then
    ok_ "$app: installed $inst is newer than the latest release ($ver) — nothing to do"; return 0
  fi

  info_ "$app: upgrading ${inst:-?} -> $ver"
  # Stage first, then replace in place. There is no removal step: the replaced files
  # are kept as a backup until the whole set has landed, so a failed download, a bad
  # checksum or a copy that cannot complete leaves the old version working.
  tmp="$(mktemp -d)"
  if ! _stage_release "$repo" "$tag" "$tmp"; then
    rm -rf "$tmp"; err_ "$app: upgrade aborted, the installed version was left in place"; return 1
  fi
  if ! _install_staged "$repo" "$ver" "$tmp"; then
    rm -rf "$tmp"; err_ "$app: upgrade failed and was rolled back; $app is still at ${inst:-its previous version}"; return 1
  fi
  rm -rf "$tmp"
  ok_ "$app: upgraded to $ver"
}

cmd_upgrade() {
  parse_target upgrade "$@"
  local r rc=0
  head_ "artcraftctl upgrade"
  for r in "${_TARGET[@]}"; do upgrade_one "$r" || rc=1; done
  return $rc
}

# ------------------------------------------------------------------- init ----
cmd_init() {
  head_ "artcraftctl init — one-time setup"
  if [[ -f "$CONFIG_FILE" ]]; then
    confirm "Config already exists at $CONFIG_FILE. Add more repos?" \
      || { info_ "keeping existing config"; return 0; }
  fi
  mkdir -p "$CONFIG_DIR"
  local added=0 input
  while true; do
    input="$(ask 'Repo to track (owner/repo, empty to finish):')"
    input="$(printf '%s' "$input" | tr -d '[:space:]')"
    [[ -z "$input" ]] && break
    if [[ "$input" != */* || "$input" == */*/* ]]; then
      warn_ "use owner/repo format (got '$input')"; continue
    fi
    info_ "checking $input"
    if gh api "repos/$input" --jq '.full_name' >/dev/null 2>&1; then
      if [[ -f "$CONFIG_FILE" ]] && grep -qxF "$input" "$CONFIG_FILE"; then
        info_ "$input already in config"
      else
        printf '%s\n' "$input" >> "$CONFIG_FILE"
        ok_ "added $input"
        added=$((added + 1))
      fi
    else
      err_ "$input: not found (or no access)"
    fi
    confirm "Add another repo?" || break
  done
  if [[ $added -gt 0 ]]; then
    ok_ "config written to $CONFIG_FILE ($added repo(s) added)"
  else
    warn_ "nothing added"
  fi
}

# ------------------------------------------------------------------- help ----
usage() {
  {
    printf '%sartcraftctl%s — installer / updater for the ArtCraft suite\n\n' "$C_HEAD" "$C_0"
    printf '%sAPP%s is an app name (resolved via the config) or owner/repo.\n\n' "$C_B" "$C_0"
    printf '  artcraftctl update    %s--app APP | --all%s   check installed vs latest (no changes)\n' "$C_B" "$C_0"
    printf '  artcraftctl upgrade   %s--app APP | --all%s   update an installed app to the latest release\n' "$C_B" "$C_0"
    printf '  artcraftctl install   %s--app APP | --all%s   install an app (refuses if already installed)\n' "$C_B" "$C_0"
    printf '  artcraftctl uninstall %s--app APP | --all%s   remove an installed app\n' "$C_B" "$C_0"
    printf '  artcraftctl init                          interactive setup; writes the config file\n'
    printf '  artcraftctl help                          this help\n\n'
    printf '%sPaths%s\n\n' "$C_B" "$C_0"
    printf '  Config    ~/.config/artcraftctl/config             one owner/repo per line\n'
    printf '  Version   ~/.local/share/artcraftctl/state/<app>\n'
    printf '  Manifest  ~/.local/share/artcraftctl/state/<app>.files\n'
    printf '  Targets   bin/ -> ~/.local/bin, share/ -> ~/.local/share\n'
  }
}

# ------------------------------------------------------------------- main ----
main() {
  need gh; need tar; need sha256sum; need find; need awk; need sort; need grep
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    update)    cmd_update "$@";;
    upgrade)   cmd_upgrade "$@";;
    install)   cmd_install "$@";;
    uninstall) cmd_uninstall "$@";;
    init)      cmd_init "$@";;
    sync)      die "'sync' was split into 'update' (check) and 'upgrade' (apply)";;
    help|-h|--help|"") usage;;
    *) die "unknown command '$cmd' (try 'artcraftctl help')";;
  esac
}
main "$@"
